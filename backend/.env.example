PORT=3000

# Local-only performance benchmark switch. Never enable in production.
PERF_TEST=false
# PERF_TEST_RATE_LIMIT=1000000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beautycare
DB_USER=root
DB_PASSWORD=
# Optional aliases accepted by the backend; keep DB_* above for compatibility.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=beautycare
# DATABASE_USER=root
# DATABASE_PASSWORD=
DB_TEST_NAME=beautycare_test

JWT_SECRET=change-me
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=1h
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1

HTTPS=false
ENFORCE_HTTPS=false
STRICT_HTTPS=false
# Set this only when an explicitly trusted reverse proxy terminates TLS.
TRUST_PROXY=false
SSL_KEY_PATH=./certs/localhost.key
SSL_CERT_PATH=./certs/localhost.crt
COOKIE_SECURE=false
COOKIE_DOMAIN=
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

AUTH_DEMO_MODE=false
EMAIL_DELIVERY_MODE=smtp
EMAIL_FALLBACK_TO_OUTBOX=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=BeautyCare
SMTP_REPLY_TO=
SMTP_REQUIRE_TLS=true
SMTP_IGNORE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_POOL=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_TEST_TO=
ADMIN_NOTIFICATION_EMAILS=

PAYMENTS_MODE=mock
API_BASE_URL=http://localhost:3000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=captureWallet
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Checkout sandbox is enabled only when PAYMENTS_MODE=real and a
# server-only `sk_test_...` key is supplied. Never put this key in frontend code.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=25000
PAYPAL_BRAND_NAME=BeautyCare
PAYPAL_LOCALE=vi-VN

METRICS=false
METRICS_KEY=
