{
  "name": "beautycare-backend",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./scripts/run-tests.js demo",
    "test:smoke": "node ./scripts/run-tests.js smoke",
    "test:db": "node ./scripts/run-tests.js db",
    "test:all": "node ./scripts/run-tests.js all",
    "db:init": "node scripts/import-mysql-schema.js",
    "db:init:test": "node scripts/init-test-database.js",
    "db:test": "node scripts/run-db-tests.js",
    "test:perf": "node scripts/perf-smoke.js",
    "test:load:smoke": "k6 run ../performance/k6-smoke.js",
    "test:load": "k6 run -e VUS=100 -e DURATION=60s ../performance/k6-load.js",
    "db:import": "node scripts/import-mysql-schema.js",
    "payments:cleanup-pending": "node scripts/cleanup-pending-payments.js",
    "smtp:verify": "node scripts/verify-smtp.js",
    "smtp:send-test": "node scripts/send-smtp-test.js",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.15.2",
    "nodemailer": "^8.0.4",
    "prom-client": "^15.1.0",
    "speakeasy": "^2.0.0",
    "stripe": "^16.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
